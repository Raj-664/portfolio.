# ------------------------------------------------------------------
# Emamuddin Mallick — Portfolio
# ------------------------------------------------------------------
#
# The backend uses SQLite automatically when no MySQL config is present.
# To use MySQL/TiDB instead, set the variables below and start the app.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio

# Port the Flask server listens on (default 5000)
PORT=5000

# ------------------------------------------------------------------
# Admin panel
# ------------------------------------------------------------------
# Credentials used to seed the admin account on first run.
# If ADMIN_PASSWORD is left unset, a random password is generated
# and printed to the console on first startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret key used to sign session cookies. Use a long random string
# (e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`).
# If left unset, a random key is generated on each start (sessions
# will not survive a restart).
SECRET_KEY=
